# Copy to .env, fill in, then load it before running anything:
#   set -a; . ./.env; set +a

# --- Clip generation (announcer/gen_clips.py) ---
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
TTS_MODEL=gemini-3.8-flash-tts          # or gemini-3.8-flash-lite-tts when the main quota runs out
TTS_VOICE=Algenib
# TTS_STYLE="[slow, smooth, laid-back West Coast hip-hop drawl, relaxed and cool, grinning]"
# LEAK_WORDS="drawl,laid-back,laid back,hip-hop,hip hop,grinning,west coast hip"
OUT_DIR=clips

# --- Playback (announcer/runner.py) ---
# Where `python3 -m http.server 8765` (run inside announcer/) serves the clips.
# Use this machine's LAN address: the speaker fetches the file itself.
CLIP_BASE_URL=http://192.0.2.10:8765/
CLIP_DIRS=clips                         # space-separated, first match wins
# Which speaker plays the clips: linkplay (LinkPlay / Up2Stream) or sonos.
SPEAKER_TYPE=linkplay

# LinkPlay / Up2Stream speaker: mDNS name, plus a fixed IP to fall back to.
SPEAKER_HOST=YourSpeaker_XXXX.local
SPEAKER_IP=192.0.2.20
BOOST=15                                # volume points added while a clip plays
# Sonos: required when SPEAKER_TYPE=sonos; with linkplay it's an optional fallback
# (leave empty to skip). Volume is 0-100, set for each clip.
SONOS_IP=192.0.2.30
SONOS_VOLUME=50
# Optional: post each announcement's text to a Telegram group.
TELEGRAM_BOT_TOKEN=123456:your-bot-token
TELEGRAM_CHAT_ID=-1001234567890
# Space-separated HHMM names to post as text only (no audio).
MUTE=
REPLAY_WINDOW_MIN=2
